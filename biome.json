{
	"$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!**/pnpm-lock.yaml",
			"!!**/dist",
			"!**/.svelte-kit",
			"!**/*.svelte"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "auto"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noNoninteractiveElementInteractions": "on"
			},
			"complexity": {
				"noForEach": "info",
				"noImplicitCoercions": "on",
				"noUselessStringConcat": "on",
				"useSimplifiedLogicExpression": "on",
				"noUselessCatchBinding": "on",
				"noUselessUndefined": "on",
				"useMaxParams": "on"
			},
			"correctness": {
				"noUndeclaredDependencies": "on",
				"noUndeclaredVariables": "on",
				"useImageSize": "on",
				"useImportExtensions": "on"
			},
			"nursery": {
				"noForIn": "error",
				"noParametersOnlyUsedInRecursion": "on",
				"noShadow": "on",
				"noSyncScripts": "on",
				"noUnnecessaryConditions": "on",
				"useArraySortCompare": "warn",
				"useFind": "warn",
				"useSortedClasses": "on"
			},
			"performance": {
				"noAwaitInLoops": "on",
				"noBarrelFile": "on",
				"noDelete": "on",
				"useTopLevelRegex": "info"
			},
			"security": {
				"noSecrets": {
					"level": "error",
					"options": {
						"entropyThreshold": 50
					}
				}
			},
			"style": {
				"noCommonJs": "on",
				"noInferrableTypes": "on",
				"noNegationElse": "on",
				"noNestedTernary": "on",
				"noParameterAssign": "on",
				"noParameterProperties": "info",
				"noUnusedTemplateLiteral": "info",
				"noUselessElse": "on",
				"noYodaExpression": "on",
				"useAsConstAssertion": "on",
				"useAtIndex": "on",
				"useCollapsedElseIf": "on",
				"useCollapsedIf": "on",
				"useConsistentArrayType": "on",
				"useConsistentBuiltinInstantiation": "on",
				"useConsistentObjectDefinitions": "info",
				"useDefaultParameterLast": "info",
				"useExportsLast": "on",
				"useFilenamingConvention": {
					"level": "on",
					"options": {
						"filenameCases": ["camelCase", "PascalCase"]
					}
				},
				"useForOf": "on",
				"useGroupedAccessorPairs": "on",
				"useNamingConvention": {
					"level": "on",
					"options": {
						"conventions": [
							{
								"selector": {
									"kind": "typeMember"
								},
								"formats": ["camelCase", "snake_case"]
							},
							{
								"selector": {
									"kind": "objectLiteralMember"
								},
								"formats": ["camelCase", "snake_case", "PascalCase"]
							}
						]
					}
				},
				"useNumberNamespace": "on",
				"useNumericSeparators": "on",
				"useObjectSpread": "on",
				"useShorthandAssign": "on",
				"useThrowOnlyError": "on",
				"useUnifiedTypeSignatures": "on",
				"useConsistentArrowReturn": "info"
			},
			"suspicious": {
				"noConstantBinaryExpressions": "on",
				"noEmptyBlockStatements": "info",
				"noEmptyInterface": "info",
				"noUnassignedVariables": "on",
				"useAwait": "info",
				"useErrorMessage": "info",
				"useNumberToFixedDigitsArgument": "info",
				"useStaticResponseMethods": "on",
				"noDeprecatedImports": "on",
				"noImportCycles": "on",
				"noUnusedExpressions": "on"
			}
		},
		"domains": {
			"project": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
