{
  "name": "ifmgrn",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "biome check --no-errors-on-unmatched --error-on-warnings --write",
    "update-types": "supabase gen types --lang typescript --linked --schema public > ./src/lib/types/database.d.ts"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@skeletonlabs/skeleton": "^4.15.2",
    "@skeletonlabs/skeleton-svelte": "^4.15.2",
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "supabase": "^2.121.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "sveltekit-superforms": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@cartamd/plugin-math": "^4.3.1",
    "@lucide/svelte": "^1.61.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.118.0",
    "carta-md": "^4.11.5",
    "github-markdown-css": "^5.9.0",
    "isomorphic-dompurify": "^4.6.0",
    "katex": "^0.17.0"
  }
}
